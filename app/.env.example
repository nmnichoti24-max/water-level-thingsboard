TB_ORIGIN=https://thingsboard.cloud
TB_API_KEY=
TB_REAL_DEVICE_ID=
TB_SIM_DEVICE_ID=
# Optional public dashboard customer UUID, used only with the SIM device.
TB_PUBLIC_SIM_ID=
# Enable only for devices whose telemetry is intended for public viewing.
TB_ENABLE_CLOUD_READ=0
TB_ENABLE_LIVE_READ=0

# Server only. Never use a VITE_ prefix for authentication configuration.
APP_ORIGIN=http://127.0.0.1:4177
AUTH_SUPABASE_URL=
AUTH_SUPABASE_PUBLISHABLE_KEY=
AUTH_SESSION_KEY=
AUTH_ENABLE_REGISTRATION=0

# Server-only Username account store. Keep registration disabled until the database is prepared.
AUTH_ENABLE_USERNAME_REGISTRATION=0
AUTH_ACCOUNT_DATABASE_URL=
AUTH_ACCOUNT_DATABASE_CA=

# Access for signed-in accounts that have no Redis ACL yet. 1 = readable without admin approval.
# An explicit Redis ACL always overrides these, so access can still be revoked per account.
AUTH_DEFAULT_SIM=0
AUTH_DEFAULT_LIVE=0

# Optional local split-host testing / production Vercel broker. Keep these server-side.
AUTH_PAGES_REDIRECT_URL=
AUTH_REDIS_REST_URL=
AUTH_REDIS_REST_TOKEN=

# Public Pages build setting, supplied by the GitHub Actions build job.
VITE_API_BASE_URL=https://esp32s3-water-level-monitor.vercel.app
